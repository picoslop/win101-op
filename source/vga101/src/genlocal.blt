;----------------------------Module-Header------------------------------;
; Module Name: GENLOCAL.BLT
;
; Parameters and generic local variables for BitBLT.
;
; Created: In Windows' distant past (c. 1983)
;
; Copyright (c) 1983 - 1987  Microsoft Corporation
;
; This file contains the parameters passed to BitBLT, as well as local
; variables that all of its code expects.
;
; The prefix "gl_" stands for "generic local". Other prefixes are "cl_"
; for "color-related local" and "dl_" for "device-related local".
;
; This file is part of a set that makes up the Windows BitBLT function
; at driver-level.
;-----------------------------------------------------------------------;

	parmD	lpDestDev		;--> to destination bitmap descriptor
	parmW	DestxOrg		;Destination origin - x coordinate
	parmW	DestyOrg		;Destination origin - y coordinate
	parmD	lpSrcDev		;--> to source bitmap descriptor
	parmW	SrcxOrg 		;Source origin - x coordinate
	parmW	SrcyOrg 		;Source origin - y coordinate
	parmW	xExt			;x extent of the BLT
	parmW	yExt			;y extent of the BLT
	parmD	Rop			;Raster operation descriptor
	parmD	lpPBrush		;--> to a physical brush (pattern)
	parmD	lpDrawMode		;--> to a drawmode



;	Generic locals (i.e. used by all BitBLT code)

	localB	gl_phase_h		;*[bp-3] Horizontal phase (rotate count)
	localB	gl_pat_row		;*[bp-4] Current row for patterns [0..7]
	localB	gl_direction		;*[bp-5] Increment/decrement flag

;;;	localB	local_enable_flag	;Local copy of the enable flag
;;;	localB	mask_flags
;
;MF_PHASE		equ	00000111b
;MF_PHASE_POSITIVE	equ	00001000b
;MF_STEP_RIGHT		equ	00010000b
;MF_WORD_FETCH		equ	00100000b
;MF_BIG_PHASE		equ	01000000b ; phase > 4
;MF_UN_USED		equ	10000000b
	localB	gl_first_fetch		;*[bp-6] Number of first fetches needed
	localB	gl_step_direction	;*[bp-7] Direction of move (left right)
	localB	cl_brush_accel		;*[bp-8] Brush accelerator
	localB	gl_the_flags		;*[bp-9] Current row for patterns [0..7]
	localB	dl_moore_flags		;*[bp-0a] More flags
	localB	bp0b
	localB	bp0c
	localW	gl_start_mask		;*[bp-0E] Mask for first dest byte
	localW	gl_last_mask		;*[bp-10] Mask for last	dest byte
	localW	gl_mask_p		;*[bp-12] Horizontal phase mask
	localD	gl_blt_addr		;*[bp-16]
	localW	gl_inner_loop_count	;*[bp-18] # of entire bytes to BLT in innnerloop
	localW	gl_src_increment	;*[bp-1a]
	localW	gl_plane_w		;*[bp-1c]
	localW	gl_src_width_bytes	;*[bp-1e]
	localW	gl_dest_increment	;*[bp-20]
	localW	gl_dest_plane_w		;*[bp-22]	
	localW	gl_dest_width_bytes	;*[bp-24]
	localW	gl_operands		;*[bp-26]
	localW	gl_start_fl 		;*[bp-28] Start of fetch/logic operation
	localW	gl_end_fl		;*[bp-2a] End   of fetch/logic operation
	localW	gl_end_fls		;*[bp-2c] End   of fetch/logic/store operation
ifndef	FOUR_PLANE
	localW	dl_addr_brush_index	;*[bp-2e] Address of brush index in code
endif
	localB	gl_pat_present		;*[bp-2f] Pattern present?
	localB	bp30			;*[bp-30]
	localB	gl_src_present		;*[bp-31]	;OK
	localB	bp32			;*[bp-32]
