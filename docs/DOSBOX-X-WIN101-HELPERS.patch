+
+static bool DBG_ReadNEHeader(PhysPt base, PhysPt &ne, std::string &name,
+		uint16_t &cseg, uint16_t &segtab, uint16_t &shift) {
+	uint8_t mz[2];
+	if (!DBG_ReadB(base,mz[0]) || !DBG_ReadB(base+1,mz[1])) return false;
+	if (mz[0]=='M' && mz[1]=='Z') {
+		uint32_t lfanew=0;
+		if (!DBG_ReadD(base+0x3C,lfanew) || lfanew > 0x10000) return false;
+		ne = base + lfanew;
+	} else if (mz[0]=='N' && mz[1]=='E') {
+		ne = base;
+	} else return false;
+	return DBG_CheckNEHeader(ne,name,cseg,segtab,shift);
+}
+
+static void DBG_NEDump(uint16_t seg, uint32_t ofs) {
+	PhysPt base=(PhysPt)GetAddress(seg,ofs);
+	PhysPt ne=0; std::string name; uint16_t cseg=0,segtab=0,shift=0;
+	if (!DBG_ReadNEHeader(base,ne,name,cseg,segtab,shift)) {
+		DEBUG_ShowMsg("DEBUG: NEDUMP no MZ/NE at %04X:%04X\n",seg,(uint16_t)ofs);
+		return;
+	}
+	uint32_t neoff=(uint32_t)(ne-base);
+	DEBUG_ShowMsg("DEBUG: NEDUMP %04X:%04X NE=+%04X name=%s segments=%u shift=%u\n",
+		seg,(uint16_t)ofs,neoff,name.empty()?"?":name.c_str(),(unsigned)cseg,(unsigned)shift);
+	uint16_t maxseg = cseg > 64 ? 64 : cseg;
+	for (uint16_t i=0;i<maxseg;i++) {
+		PhysPt ent=ne+segtab+(uint32_t)i*8;
+		uint16_t foff=0, slen=0, flags=0, minalloc=0;
+		if (!DBG_ReadW(ent,foff)||!DBG_ReadW(ent+2,slen)||
+		    !DBG_ReadW(ent+4,flags)||!DBG_ReadW(ent+6,minalloc)) break;
+		DEBUG_ShowMsg("DEBUG:   seg %02u file=%04X len=%04X flags=%04X min=%04X\n",
+			(unsigned)(i+1),(unsigned)foff,(unsigned)slen,(unsigned)flags,(unsigned)minalloc);
+	}
+}
+
+static void DBG_WINScan(void) {
+	unsigned found=0;
+	for (uint32_t para=0; para<0xA000; ++para) {
+		PhysPt base=(PhysPt)(para<<4);
+		uint8_t mz[2];
+		if (!DBG_ReadB(base,mz[0])||!DBG_ReadB(base+1,mz[1])) continue;
+		const bool is_mz = (mz[0]=='M' && mz[1]=='Z');
+		const bool is_ne = (mz[0]=='N' && mz[1]=='E');
+		if (!is_mz && !is_ne) continue;
+		PhysPt ne=0; std::string name; uint16_t cseg=0,segtab=0,shift=0;
+		if (is_mz && DBG_ReadNEHeader(base,ne,name,cseg,segtab,shift)) {
+			uint32_t neoff=(uint32_t)(ne-base);
+			DEBUG_ShowMsg("DEBUG: WINSCAN MZ=%04X:0000 NE=%04X:%04X name=%s segs=%u\n",
+				(unsigned)para,(unsigned)para,(unsigned)neoff,name.empty()?"?":name.c_str(),(unsigned)cseg);
+			found++;
+			continue;
+		}
+		/* Windows 1.01 keeps the module header as a bare NE structure at
+		 * a segment base (the MZ stub is gone); the loader-linked list
+		 * also uses offset 6 as the next header segment. */
+		if (is_ne && DBG_CheckNEHeader(base,name,cseg,segtab,shift)) {
+			uint16_t next=0;
+			DBG_ReadW(base+6,next);
+			DEBUG_ShowMsg("DEBUG: WINSCAN NE=%04X:0000 name=%s segs=%u next=%04X\n",
+				(unsigned)para,name.empty()?"?":name.c_str(),(unsigned)cseg,(unsigned)next);
+			found++;
+		}
+	}
+	DEBUG_ShowMsg("DEBUG: WINSCAN %u MZ/NE module(s)\n",found);
+}
