+/* Debugger-only deterministic serial-mouse injection.  This bypasses the
+ * host capture lock so a trace can drive the guest mouse while the CPU is
+ * running.  The serial packet code divides by four, so feed it pixels*4. */
+void Mouse_InjectRelative(int dx,int dy) {
+	extern bool user_cursor_locked;
+	const bool old_locked = user_cursor_locked;
+	user_cursor_locked = true;  // serialmouse only accumulates while locked
+	on_mouse_event_for_serial(dx * 4, dy * 4, mouse.buttons);
+	user_cursor_locked = old_locked;
+
+	mouse.x += dx;
+	mouse.y += dy;
+	if (mouse.x > mouse.max_x) mouse.x = mouse.max_x;
+	if (mouse.x < mouse.min_x) mouse.x = mouse.min_x;
+	if (mouse.y > mouse.max_y) mouse.y = mouse.max_y;
+	if (mouse.y < mouse.min_y) mouse.y = mouse.min_y;
+}
