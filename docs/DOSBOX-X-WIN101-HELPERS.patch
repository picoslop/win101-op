+/* ---- Windows 1.01 / NE helpers added for this RE workspace ---- */
+static bool DBG_ReadB(PhysPt a, uint8_t &v) { return !mem_readb_checked(a, &v); }
+static bool DBG_ReadW(PhysPt a, uint16_t &v) { return !mem_readw_checked((LinearPt)a, &v); }
+static bool DBG_ReadD(PhysPt a, uint32_t &v) { return !mem_readd_checked((LinearPt)a, &v); }
+
+static bool DBG_ReadNEString(PhysPt addr, uint32_t maxlen, std::string &out) {
+	out.clear();
+	uint8_t len = 0;
+	if (!DBG_ReadB(addr, len)) return false;
+	if (len == 0 || len > 64 || len > maxlen) return false;
+	for (unsigned i = 0; i < len; ++i) {
+		uint8_t c = 0;
+		if (!DBG_ReadB(addr + 1 + i, c)) return false;
+		out.push_back((char)c);
+	}
+	return true;
+}
+
+static void DBG_MemDumpAscii(uint16_t seg, uint32_t ofs, uint32_t num) {
+	if (num == 0) { DEBUG_ShowMsg("DEBUG: MEMDUMPASC length is zero\n"); return; }
+	if (num > 0x2000) num = 0x2000;
+	PhysPt addr = (PhysPt)GetAddress(seg, ofs);
+	for (uint32_t done = 0; done < num; done += 16) {
+		uint32_t row = (num - done < 16) ? (num - done) : 16;
+		std::ostringstream line;
+		line << std::uppercase << std::hex << std::setfill('0')
+		     << std::setw(4) << seg << ':' << std::setw(4) << (ofs + done) << "  ";
+		char ascii[17];
+		for (uint32_t i = 0; i < 16; ++i) {
+			if (i < row) {
+				uint8_t v = 0;
+				if (!DBG_ReadB(addr + done + i, v)) {
+					line << "?? ";
+					ascii[i] = '?';
+				} else {
+					line << std::setw(2) << (unsigned)v << ' ';
+					ascii[i] = (v >= 0x20 && v < 0x7F) ? (char)v : '.';
+				}
+			} else {
+				line << "   ";
+				ascii[i] = ' ';
+			}
+		}
+		ascii[16] = 0;
+		line << " |" << ascii << '|';
+		DEBUG_ShowMsg("%s\n", line.str().c_str());
+	}
+}
+
+static bool DBG_ParseTwoRanges(char *found, uint16_t &s1, uint32_t &o1,
+		uint16_t &s2, uint32_t &o2, uint32_t &len) {
+	unsigned a=0,b=0,c=0,d=0,e=0;
+	int used=0;
+	if (sscanf(found, "%x:%x %x:%x %x%n", &a,&b,&c,&d,&e,&used) != 5) return false;
+	if (a > 0xFFFF || c > 0xFFFF || e == 0 || e > 0x100000) return false;
+	s1=(uint16_t)a; o1=b; s2=(uint16_t)c; o2=d; len=e;
+	return true;
+}
+
+static void DBG_MemCmp(uint16_t s1, uint32_t o1, uint16_t s2, uint32_t o2, uint32_t len) {
+	PhysPt a=(PhysPt)GetAddress(s1,o1), b=(PhysPt)GetAddress(s2,o2);
+	uint32_t diffs=0, first=0xFFFFFFFF;
+	for (uint32_t i=0;i<len;i++) {
+		uint8_t x=0,y=0;
+		if (!DBG_ReadB(a+i,x) || !DBG_ReadB(b+i,y)) {
+			DEBUG_ShowMsg("DEBUG: MEMCMP cannot read at +%04X\n", i); return;
+		}
+		if (x != y) {
+			if (first == 0xFFFFFFFF) first=i;
+			if (diffs < 32)
+				DEBUG_ShowMsg("DEBUG: MEMCMP +%04X  %02X:%04X=%02X  %02X:%04X=%02X\n",
+					i, s1, (uint16_t)(o1+i), x, s2, (uint16_t)(o2+i), y);
+			diffs++;
+		}
+	}
+	if (diffs == 0) DEBUG_ShowMsg("DEBUG: MEMCMP identical (%04X bytes)\n", (unsigned)len);
+	else DEBUG_ShowMsg("DEBUG: MEMCMP %04X differences, first at +%04X\n", (unsigned)diffs, first);
+}
+
+static void DBG_MemFindStr(uint16_t seg, uint32_t ofs, uint32_t len, const char *needle) {
+	std::string pat(needle ? needle : "");
+	if (pat.empty()) { DEBUG_ShowMsg("DEBUG: MEMFINDSTR needs a string\n"); return; }
+	if (pat.size() > len) { DEBUG_ShowMsg("DEBUG: MEMFINDSTR string longer than range\n"); return; }
+	PhysPt a=(PhysPt)GetAddress(seg,ofs);
+	unsigned hits=0;
+	for (uint32_t i=0;i+pat.size()<=len;i++) {
+		bool ok=true;
+		for (size_t j=0;j<pat.size();j++) {
+			uint8_t v=0;
+			if (!DBG_ReadB(a+i+j,v)) { ok=false; break; }
+			char c=(char)v;
+			if (toupper((unsigned char)c) != toupper((unsigned char)pat[j])) { ok=false; break; }
+		}
+		if (ok) {
+			if (hits < 32) DEBUG_ShowMsg("DEBUG: MEMFINDSTR %04X:%04X\n", seg, (uint16_t)(ofs+i));
+			hits++;
+		}
+	}
+	DEBUG_ShowMsg("DEBUG: MEMFINDSTR %u hit(s) for '%s'\n", hits, pat.c_str());
+}
+
+static bool DBG_CheckNEHeader(PhysPt ne, std::string &name,
+		uint16_t &cseg, uint16_t &segtab, uint16_t &shift) {
+	uint8_t sig[2];
+	if (!DBG_ReadB(ne,sig[0]) || !DBG_ReadB(ne+1,sig[1])) return false;
+	if (sig[0]!='N' || sig[1]!='E') return false;
+	uint16_t rn=0;
+	if (!DBG_ReadW(ne+0x26,rn)) return false;
+	if (!DBG_ReadW(ne+0x1C,cseg)) return false;
+	if (!DBG_ReadW(ne+0x22,segtab)) return false;
+	if (!DBG_ReadW(ne+0x32,shift)) return false;
+	/* Reject chance "NE" byte pairs in code/data. */
+	if (cseg == 0 || cseg > 64 || segtab >= 0x8000 || shift > 16) return false;
+	if (rn && !DBG_ReadNEString(ne+rn, 512, name)) name.clear();
+	return true;
+}
+
+static void DBG_MemFindHex(uint16_t seg, uint32_t ofs, uint32_t len, const std::vector<uint8_t> &pat) {
+	if (pat.empty()) { DEBUG_ShowMsg("DEBUG: MEMFINDHEX needs a byte pattern\n"); return; }
+	if (pat.size() > len) { DEBUG_ShowMsg("DEBUG: MEMFINDHEX pattern longer than range\n"); return; }
+	PhysPt a=(PhysPt)GetAddress(seg,ofs);
+	unsigned hits=0;
+	for (uint32_t i=0;i+pat.size()<=len;i++) {
+		bool ok=true;
+		for (size_t j=0;j<pat.size();j++) {
+			uint8_t v=0;
+			if (!DBG_ReadB(a+i+j,v) || v!=pat[j]) { ok=false; break; }
+		}
+		if (ok) {
+			if (hits < 64)
+				DEBUG_ShowMsg("DEBUG: MEMFINDHEX %04X:%04X\n", seg, (uint16_t)(ofs+i));
+			hits++;
+		}
+	}
