+/* ---- in-emulator segment-load trace (LOGSEGLOAD) ----
+ * The Windows loader calls KERNEL's SEGLOAD() for every code/data
+ * segment.  Logging from inside the emulation loop (rather than
+ * stopping for every event) keeps the timing intact; the resulting
+ * SEGLOAD.TXT is parsed later at a convenient breakpoint. */
+static bool seglog_active = false;
+static uint16_t seglog_seg = 0;
+static uint32_t seglog_off = 0;
+static bool seglog_ret_pending = false;
+static uint16_t seglog_ret_seg = 0;
+static uint32_t seglog_ret_off = 0;
+static FILE *seglog_fp = nullptr;
+
+static void DBG_SegLogClose(void) {
+	if (seglog_fp) { fflush(seglog_fp); fclose(seglog_fp); seglog_fp = nullptr; }
+	seglog_active = false;
+	seglog_ret_pending = false;
+}
+
+static void DBG_SegLogCheck(void) {
+	if (!seglog_active) return;
+	const uint16_t curcs = SegValue(cs);
+	const uint32_t ip = reg_eip;
+	if (seglog_ret_pending && curcs == seglog_ret_seg && ip == seglog_ret_off) {
+		fprintf(seglog_fp, "R %04X:%04X AX=%04X BX=%04X CX=%04X DX=%04X\n",
+			curcs, ip, reg_ax, reg_bx, reg_cx, reg_dx);
+		fflush(seglog_fp);
+		seglog_ret_pending = false;
+		return;
+	}
+	if (curcs == seglog_seg && ip == seglog_off) {
+		const uint16_t curss = SegValue(ss);
+		const uint32_t sp = reg_sp;
+		PhysPt p = (PhysPt)(((uint32_t)curss << 4) + sp);
+		uint16_t ret=0,p1=0,p2=0,p3=0,p4o=0,p4s=0;
+		mem_readw_checked((LinearPt)p, &ret);
+		mem_readw_checked((LinearPt)(p+2), &p1);
+		mem_readw_checked((LinearPt)(p+4), &p2);
+		mem_readw_checked((LinearPt)(p+6), &p3);
+		mem_readw_checked((LinearPt)(p+8), &p4o);
+		mem_readw_checked((LinearPt)(p+10), &p4s);
+		char nm[65]; int nl=0;
+		if (p4s) {
+			PhysPt hp=(PhysPt)((uint32_t)p4s << 4);
+			uint8_t s0=0,s1=0;
+			if (!mem_readb_checked((LinearPt)hp,&s0) &&
+			    !mem_readb_checked((LinearPt)(hp+1),&s1) && s0=='N' && s1=='E') {
+				uint16_t rn=0;
+				mem_readw_checked((LinearPt)(hp+0x26),&rn);
+				uint8_t len=0;
+				if (rn && !mem_readb_checked((LinearPt)(hp+rn),&len) &&
+				    len>0 && len<=64) {
+					for (unsigned i=0;i<len;i++) {
+						uint8_t c=0;
+						if (mem_readb_checked((LinearPt)(hp+rn+1+i),&c)) { nl=0; break; }
+						nm[nl++] = (c>=0x20 && c<0x7F) ? (char)c : '?';
+					}
+				}
+			}
+		}
+		nm[nl]=0;
+		fprintf(seglog_fp, "E %04X:%04X SP=%04X ret=%04X p1=%04X p2=%04X p3=%04X p4=%04X:%04X name=%s\n",
+			curcs, ip, sp, ret, p1, p2, p3, p4s, p4o, nm);
+		fflush(seglog_fp);
+		seglog_ret_seg = curcs;
+		seglog_ret_off = ret;
+		seglog_ret_pending = true;
+	}
+}
 
 
