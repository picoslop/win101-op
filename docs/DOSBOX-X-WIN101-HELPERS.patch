+/* Binary CPU trace ("LOGB").  One little-endian file header followed by
+ * variable-length records.  Each record carries CS:IP plus only the
+ * registers (and EFLAGS) whose values differ from the previous record.
+ *
+ * File header (16 bytes):
+ *   0  8  magic "DBXTRC1\0"
+ *   8  2  version (1)
+ *  10  2  file header size (16)
+ *  12  2  per-instruction header size (8)
+ *  14  2  flags (reserved, 0)
+ *
+ * Per instruction record:
+ *   0  2  CS
+ *   2  4  EIP
+ *   6  2  changed mask
+ *   8  4*N changed register values, ascending mask bit
+ *
+ * Mask bits: 0 EAX, 1 EBX, 2 ECX, 3 EDX, 4 ESI, 5 EDI, 6 EBP,
+ * 7 ESP, 8 DS, 9 ES, 10 FS, 11 GS, 12 SS, 13 EFLAGS; bit 14 reserved;
+ * bit 15 = changed-memory extension present.  CS:IP are always present.
+ * The first record has bits 0-13 set so a decoder gets an initial state.
+ *
+ * The low 14 mask bits determine N, so the fixed part of the record is
+ * inferred as 8 + 4*popcount(mask & 0x3FFF).  When bit 15 is set, the
+ * memory extension follows; it is self-sizing as well.
+ *
+ * Reserved changed-memory extension (after the register values, bit 15):
+ *   0  2  run count
+ *   2  ... runs, each:
+ *         0  2  segment
+ *         2  4  offset
+ *         6  2  byte count (number of changed bytes in this contiguous row)
+ *         8  ... byte count data bytes, no padding
+ *
+ * A run's byte count is explicit so a contiguous write of any length is
+ * represented without a fixed data slot.  Runs carry only changed bytes;
+ * no trailing alignment is inserted.
+ */
+static bool binLogHavePrev = false;
+static uint32_t binLogPrev[14];
+#define BINLOG_REG_MASK  0x3FFFu  // bits 0-13: registers and EFLAGS
+#define BINLOG_MEM_MASK  0x8000u  // bit 15: changed-memory extension
+
+static void WriteLE16(std::ofstream& out, uint16_t v) {
+	char b[2] = { (char)(v & 0xFF), (char)((v >> 8) & 0xFF) };
+	out.write(b, sizeof(b));
+}
+
+static void WriteLE32(std::ofstream& out, uint32_t v) {
+	char b[4] = { (char)(v & 0xFF), (char)((v >> 8) & 0xFF),
+		(char)((v >> 16) & 0xFF), (char)((v >> 24) & 0xFF) };
+	out.write(b, sizeof(b));
+}
+
+static void ResetBinaryCpuLog(void) {
+	binLogHavePrev = false;
+	memset(binLogPrev, 0, sizeof(binLogPrev));
+}
+
+static void WriteBinaryCpuLogHeader(std::ofstream& out) {
+	static const char magic[8] = { 'D','B','X','T','R','C','1','\0' };
+	out.write(magic, sizeof(magic));
+	WriteLE16(out, 1);   // format version
+	WriteLE16(out, 16);  // file header bytes
+	WriteLE16(out, 8);   // per-instruction header bytes
+	WriteLE16(out, 0);   // flags: reserved
+}
+
+static const char *CpuLogFileName(void) {
+	return cpuLogType == 4 ? "LOGCPU.BIN" : "LOGCPU.TXT";
+}
+
+static void WriteBinaryCpuLog(uint16_t segValue, uint32_t eipValue, std::ofstream& out) {
+	uint32_t cur[14] = {
+		reg_eax, reg_ebx, reg_ecx, reg_edx, reg_esi, reg_edi, reg_ebp, reg_esp,
+		(uint32_t)SegValue(ds), (uint32_t)SegValue(es),
+		(uint32_t)SegValue(fs), (uint32_t)SegValue(gs),
+		(uint32_t)SegValue(ss), (uint32_t)reg_flags
+	};
+	uint16_t mask = 0;
+	if (!binLogHavePrev) {
+		mask = BINLOG_REG_MASK;  // initial state
+	} else {
+		for (unsigned i = 0; i < 14; i++) {
+			if (cur[i] != binLogPrev[i]) mask |= (uint16_t)(1u << i);
+		}
+	}
+
+	// Bits 0-13 are register/flag changes; bit 15 is reserved for a
+	// changed-memory extension.  The low-bit count makes the fixed part
+	// of this record self-sizing.  No memory extension is emitted yet.
+	WriteLE16(out, segValue);
+	WriteLE32(out, eipValue);
+	WriteLE16(out, mask);
+	for (unsigned i = 0; i < 14; i++) {
+		if (mask & (uint16_t)(1u << i)) WriteLE32(out, cur[i]);
+		binLogPrev[i] = cur[i];
+	}
+	binLogHavePrev = true;
+}
 #endif
 
 
